{
  "expo": {
    "name": "Convo",
    "slug": "convo",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "convo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mihirkavi.convo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mihirkavi.convo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Convo to match message senders and review contact cleanup suggestions."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2f0016fb-678c-415a-9ed7-dda81c8ecb52"
      }
    },
    "owner": "mihirkavishwar"
  }
}
