{
  "expo": {
    "name": "Open Media",
    "slug": "convo",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": ["openmedia", "convo"],
    "description": "One app for your social world. Message people on Open Media and connect supported accounts without losing identity or provenance.",
    "backgroundColor": "#F7F5F0",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.mihirkavi.convo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mihirkavi.convo",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#111111"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Open Media to match message senders and review contact cleanup suggestions."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2f0016fb-678c-415a-9ed7-dda81c8ecb52"
      }
    },
    "owner": "mihirkavishwar"
  }
}
