{
  "name": "open-media",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.109.0",
    "deso-protocol": "3.4.1",
    "expo": "~57.0.31",
    "expo-contacts": "~57.0.8",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "hls.js": "1.6.13",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@farcaster/core": "0.20.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "~19.2.2",
    "nodemailer": "^10.1.1",
    "supabase": "2.114.0",
    "tsx": "^4.23.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "local": "node --import tsx scripts/local.ts",
    "local:stop": "npx supabase stop",
    "local:email": "node --import tsx scripts/local-email.ts",
    "app:install": "node --import tsx scripts/install-mac-app.ts",
    "app:uninstall": "node --import tsx scripts/install-mac-app.ts --uninstall",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:native": "expo run:ios",
    "web": "expo start --web",
    "mail:server": "npm run dev --prefix services/mail-sync",
    "matrix:server": "node --import tsx services/matrix-bridge/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts src/connectors/publishing/*.test.ts plugins/*.test.ts",
    "test:db": "supabase test db",
    "export:web": "expo export --platform web --output-dir .expo-dist",
    "check": "npm run typecheck && npm test && npm run typecheck --prefix services/mail-sync && npm test --prefix services/mail-sync && npm run export:web",
    "mail:check": "npm run check-mailbox --prefix services/mail-sync"
  },
  "private": true,
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
