{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "convo-mail-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "CONVO_APP_ORIGIN": "*",
    "EVENTS_OWNER_USER_ID": "owner",
    "EVENTS_PUBLIC_ORIGIN": "https://convo-mail-sync.convo-mail-sync.workers.dev",
    // Hosts that serve the web app (built by `npm run build:web` at the repository root).
    "WEB_APP_HOSTS": "openmedia.site,www.openmedia.site"
  },
  // The web app's static files. The Worker runs first and decides, by host and path, whether a
  // request is for the web app or for the API and agent site.
  "assets": {
    "directory": "../../.web-dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Open Media Events (Layer 1): canonical events, plans and preferences.
  "d1_databases": [
    {
      "binding": "EVENTS_DB",
      "database_name": "open-media-events",
      "database_id": "ed5c017c-34c7-4012-bf5c-bee065131269",
      "migrations_dir": "migrations"
    }
  ],
  // OAuth 2.1 grants and tokens for MCP clients (ChatGPT, Claude, others).
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "c72df5681f2744bd9ca1bb9f04158c80"
    }
  ],
  // Optional semantic matching for event search.
  "ai": {
    "binding": "AI"
  },
  // Re-read upcoming planned events so changes (time, venue, cancellation) surface.
  "triggers": {
    "crons": ["17 */4 * * *"]
  },
  "ratelimits": [
    {
      "name": "MAIL_CONNECT_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "MAIL_SYNC_RATE_LIMITER",
      "namespace_id": "10002",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "MAIL_SEND_RATE_LIMITER",
      "namespace_id": "10004",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_API_RATE_LIMITER",
      "namespace_id": "10003",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
