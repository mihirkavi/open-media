{
  "name": "@convo/mail-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.dev.vars --import tsx src/localServer.ts",
    "start": "node --env-file=.dev.vars --import tsx src/localServer.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/events/*.test.ts src/ondc/*.test.ts",
    "worker:types": "wrangler types",
    "worker:check": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy",
    "worker:dev": "wrangler dev --port 8787 --ip 127.0.0.1",
    "check-mailbox": "node --import tsx scripts/check-mailbox.ts",
    "ondc:keys": "node --import tsx scripts/ondc-keys.ts",
    "ondc:subscribe": "node --import tsx scripts/ondc-subscribe.ts",
    "ondc:e2e": "node --import tsx scripts/ondc-e2e.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@jsonresume/jsonresume-to-rendercv": "1.0.13",
    "@jsonresume/schema": "1.3.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "calcom-availability": "github:mihirkavi/calcom-availability#v0.1.1",
    "imapflow": "^1.0.195",
    "jose": "^6.1.3",
    "jsonresume-theme-even": "0.26.1",
    "luma-discovery": "github:mihirkavi/luma-discovery#v0.1.1",
    "mailparser": "^3.9.4",
    "nodemailer": "^10.2.1",
    "structured-event-feeds": "github:mihirkavi/structured-event-feeds#v0.1.1",
    "viem": "2.57.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.6",
    "typescript": "~6.0.3",
    "wrangler": "^4.150.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
