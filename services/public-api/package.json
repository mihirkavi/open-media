{
  "name": "@open-media/public-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "worker:check": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.23.6",
    "typescript": "~6.0.3",
    "wrangler": "^4.120.0"
  }
}
