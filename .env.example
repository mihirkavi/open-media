EXPO_PUBLIC_SUPABASE_URL=https://sgqrkbsmroytevkgogoy.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-active-sb_publishable-key
EXPO_PUBLIC_OPEN_MEDIA_API_URL=http://127.0.0.1:8787

# Public read API base URL, shown to signed-out visitors as the open-data link.
EXPO_PUBLIC_OPEN_MEDIA_PUBLIC_API_URL=

# Cross-posting to Lens: Open Media's own Lens App address (public, not a secret). Empty uses
# Lens's public test app, which is fine for development; register Open Media's app before launch.
EXPO_PUBLIC_LENS_APP_ADDRESS=

# Set to 1 once production sign-in emails go through custom SMTP with the repo's templates, which
# include a one-time code. Until then the app asks people to open the emailed link instead.
EXPO_PUBLIC_SIGN_IN_EMAIL_CODES=
